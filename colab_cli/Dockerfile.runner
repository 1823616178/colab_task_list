# Python Runner（colab_runner）：FastAPI + uvicorn，监听容器内 0.0.0.0:8765（仅 compose 内部网络）
FROM python:3.12-slim

ARG INSTALL_BACKENDS=0
ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /srv/colab_cli
COPY requirements.txt requirements-backends.txt ./
RUN pip install -r requirements.txt \
    && if [ "$INSTALL_BACKENDS" = "1" ]; then pip install -r requirements-backends.txt; fi

COPY . .

ENV COLAB_RUNNER_HOST=0.0.0.0 \
    COLAB_RUNNER_PORT=8765 \
    COLAB_OUTPUT_DIR=/data/colab_output \
    COLAB_BACKEND_STATE_DIR=/data/backend_state
EXPOSE 8765
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
    CMD curl -fsS "http://127.0.0.1:${COLAB_RUNNER_PORT}/health" -H "X-Internal-Token: ${COLAB_RUNNER_TOKEN}" >/dev/null || exit 1
CMD ["python", "-m", "colab_runner"]
