# Docker 可选覆盖项。数据库、JWT、管理员、Runner 密钥直接复用 web/.env。
# 默认不需要本文件：
#   mkdir -p secrets/colab
#   docker compose --env-file web/.env up -d --build
# 要覆盖以下配置，复制为 .env.docker 并在启动命令中同时加载：
#   docker compose --env-file web/.env --env-file .env.docker up -d --build

# 默认沿用 web/.env 的 NITRO_PORT / NITRO_HOST；缺省 127.0.0.1:54471。
# WEB_PORT=54471
# WEB_BIND=0.0.0.0
# 本机 HTTP 为 false；HTTPS 反向代理部署时改 true。
AUTH_COOKIE_SECURE=false
TZ=Asia/Shanghai
OUTPUT_RETENTION_DAYS=14
RUNNER_WORKERS=4
COLAB_TRANSPORT=native

# 容器不能直接出网时，指定容器可访问的 HTTP 代理（同时用于构建和运行）。
# DOCKER_HTTP_PROXY=http://192.168.1.25:57759
# 内网服务必须绕过代理；将数据库、FTP 等内网地址也加入。
# DOCKER_NO_PROXY=localhost,127.0.0.1,::1,runner,web,host.docker.internal,192.168.1.25

# 默认关闭开发用的表结构自动同步；启动仍按 web/.env 执行迁移。
DOCKER_DB_SYNCHRONIZE=false
DOCKER_DB_LOGGING=false

# 默认读取 web/.env 中的 NUXT_DB_*；宿主 MySQL 也可用下面的地址。
# 容器内的 127.0.0.1 是容器自身，不能用来连接宿主 MySQL。
# NUXT_DB_HOST=host.docker.internal

# OAuth 凭据目录，容器内是 /home/runner/.config/colab-cli（须可写以刷新令牌）。
# 已在宿主登录过，可改为绝对路径，如 /home/your-user/.config/colab-cli。
COLAB_AUTH_DIR=./secrets/colab

# 计算后端默认 colab；kaggle/modal 需要 INSTALL_BACKENDS=1 后重建。
COMPUTE_BACKEND=colab
INSTALL_BACKENDS=0
# Kaggle（https://www.kaggle.com/settings → Create New Token 里的 username/key）
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_MODELS_DATASET=
# Modal（modal token new 后 ~/.modal.toml 里的 token_id / token_secret）
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_SECRETS=

# 其余 NUXT_* 也可在此覆盖，例如 FTP、通知、数据库连接。
