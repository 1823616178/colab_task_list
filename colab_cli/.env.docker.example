# docker compose 用：复制为 .env.docker 后填写（.env.docker 已被 .gitignore 忽略，勿提交）
#   docker compose --env-file .env.docker up -d --build

# ── 必填密钥（可用 `python -c "import secrets;print(secrets.token_hex(32))"` 生成）──
RUNNER_TOKEN=__填随机串__
JWT_SECRET=__填随机64位十六进制__
DB_PASSWORD=__填数据库密码__
DB_ROOT_PASSWORD=__填数据库root密码__
ADMIN_USERNAME=admin
ADMIN_PASSWORD=__填初始管理员密码__

# ── 可选 ──
DB_USER=colab
DB_NAME=colab_task
WEB_PORT=3000
# 只本机访问用 127.0.0.1；局域网访问改 0.0.0.0（同时建议上 HTTPS 并把 AUTH_COOKIE_SECURE 改 true）
WEB_BIND=127.0.0.1
AUTH_COOKIE_SECURE=false
TZ=Asia/Shanghai
OUTPUT_RETENTION_DAYS=14
RUNNER_WORKERS=4
COLAB_TRANSPORT=native

# ── 计算后端 ──
# 默认 colab；kaggle/modal 需要镜像装可选依赖：INSTALL_BACKENDS=1
COMPUTE_BACKEND=colab
INSTALL_BACKENDS=0
# Colab：google-colab-cli 的登录目录（宿主上先 `colab auth login` 后把目录内容放这里）
COLAB_AUTH_DIR=./secrets/colab
# Kaggle（https://www.kaggle.com/settings → Create New Token 里的 username/key）
KAGGLE_USERNAME=
KAGGLE_KEY=
KAGGLE_MODELS_DATASET=
# Modal（modal token new 后 ~/.modal.toml 里的 token_id / token_secret）
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
MODAL_SECRETS=

# ── 其余 NUXT_* 原样透传给 web，如 FTP 镜像 ──
# NUXT_FTP_HOST=192.168.1.25
# NUXT_FTP_USER=
# NUXT_FTP_PASSWORD=
