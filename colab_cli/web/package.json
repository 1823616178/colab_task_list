    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "@types/jsonwebtoken": "^9.0.10",
    "eslint": "^10.9.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.14.1",
    "stylelint-config-html": "^2.0.0",
