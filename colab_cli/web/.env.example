# colab-console 环境变量模板。复制为 .env 并填入真实值（.env 已 gitignore）。
NUXT_DB_HOST=127.0.0.1
NUXT_DB_PORT=3306
NUXT_DB_USER=colab
NUXT_DB_PASSWORD=__填数据库密码__
NUXT_DB_NAME=colab_task
# 根据实体自动同步表结构（生产保持 false）
NUXT_DB_SYNCHRONIZE=false
# 启动时自动执行尚未执行的迁移
NUXT_DB_MIGRATIONS_RUN=true
# 输出 TypeORM 数据库日志
NUXT_DB_LOGGING=false
# openssl rand -hex 32 生成
NUXT_JWT_SECRET=__填随机64位十六进制__
# 初始管理员（仅 007 seed migration 首次建库时生效，首次登录强制改密）
NUXT_ADMIN_USERNAME=admin
NUXT_ADMIN_PASSWORD=__填初始管理员密码__
# 生产 HTTPS 必须为 true；本地 http 调试置 false
NUXT_AUTH_COOKIE_SECURE=true
# P3：Runner 内部服务（X-Internal-Token 共享密钥，与 Runner 的 COLAB_RUNNER_TOKEN 一致）
NUXT_RUNNER_URL=http://127.0.0.1:8765
NUXT_RUNNER_TOKEN=__填Runner共享密钥__
# 仓库根（workflows/*.json 同步源）
NUXT_REPO_ROOT=/path/to/colab_cli
# Runner 输出目录，须与 Runner 的 COLAB_OUTPUT_DIR 一致（同机共享，log/output 直读）
NUXT_RUNNER_OUTPUT_DIR=/path/to/colab_cli/colab_output
# P5：终态任务产物保留天数（每日定时清理，默认 14；<=0 或非法值禁用清理）
NUXT_OUTPUT_RETENTION_DAYS=14
# 成功产物「既未在控制台下载、FTP 也未同步成功」时的延长保留期（天），缺省 = 4 × 标准保留期
NUXT_OUTPUT_UNSYNCED_RETENTION_DAYS=56
# 成功产物 FTP 镜像（密码仅写入 .env，禁止提交版本库）
NUXT_FTP_HOST=192.168.1.25
NUXT_FTP_PORT=21
NUXT_FTP_USER=__填FTP用户名__
NUXT_FTP_PASSWORD=__填FTP密码__
NUXT_FTP_DIRECTORY=colab
NUXT_FTP_SECURE=false

# 任务终态通知 Webhook（留空=关闭）。类型 dingtalk|feishu|wecom|generic，缺省按 URL 识别
NUXT_NOTIFY_WEBHOOK_URL=
NUXT_NOTIFY_WEBHOOK_KIND=
# 钉钉/飞书机器人「加签」密钥（可选）
NUXT_NOTIFY_WEBHOOK_SECRET=
# 需要通知的终态，逗号分隔（缺省 succeeded,failed,recoverable,orphaned）
NUXT_NOTIFY_ON=
# 控制台外部访问地址，消息里生成任务详情链接（可选）
NUXT_NOTIFY_CONSOLE_URL=

# 监听地址与端口（0.0.0.0 = 局域网可访问）。
# nuxt dev 用 nuxt.config.ts 的 devServer；nuxt preview 读这里；
# 生产 `npm start` 会自动加载本文件中的变量。
NITRO_HOST=0.0.0.0
NITRO_PORT=54471
