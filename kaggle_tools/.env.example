# 复制为 .env 后按需修改; 真实环境变量优先于 .env。
# ---- kllm 网关 ----
KLLM_HOST=127.0.0.1
KLLM_PORT=8799
# 本地访问密钥, 留空表示不校验(只监听回环地址时可接受)
KLLM_LOCAL_KEY=
# 缓存目录(凭据缓存 + 用量账本), 默认 ~/.cache/kllm
# KLLM_CACHE_DIR=
KLLM_TIMEOUT=600
KLLM_DEFAULT_MODEL=google/gemini-3-flash-preview
# 重试次数与退避基数(秒)。默认只重试 429/503 和"请求未送达"的连接错误;
# 500/502 时上游可能已处理并计费, 要重试需显式加入, 如 429,500,502,503
KLLM_MAX_RETRIES=3
KLLM_RETRY_STATUSES=429,503
KLLM_RETRY_BASE_DELAY=1.0
KLLM_RETRY_MAX_DELAY=30
# 本地额度上限(美元), 达到后网关返回 429; 0 表示不限制
KLLM_DAILY_LIMIT=10
KLLM_MONTHLY_LIMIT=100
# 达到上限的这个比例时告警(日志 + X-KLLM-Budget-Warning 响应头)
KLLM_BUDGET_WARN_RATIO=0.8
# 用量按哪个时区切分"今天/本月"
KLLM_TIMEZONE=Asia/Shanghai
# 同时转发给上游的请求数, 多出的排队
KLLM_MAX_CONCURRENCY=4
# 首选模型 429/5xx/网络失败时依次尝试的备用模型(逗号分隔)
KLLM_FALLBACK_MODELS=
# 日志: DEBUG / INFO / WARNING / ERROR; 可选写日志文件
KLLM_LOG_LEVEL=INFO
# KLLM_LOG_FILE=
# ---- kcloud ----
KCLOUD_DEFAULT_MODEL=anthropic/claude-sonnet-5@default
# 产物目录, 默认 ./runs
# KCLOUD_RUNS_DIR=
KCLOUD_RUN_WAIT=900
KCLOUD_PUSH_WAIT=600
# 单条 kaggle 命令的超时(秒)
KAGGLE_CLI_TIMEOUT=1800
