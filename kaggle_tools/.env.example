# 复制为 .env 后按需修改; 真实环境变量优先于 .env。
# ---- kllm 网关 ----
KLLM_HOST=127.0.0.1
KLLM_PORT=8799
# 本地访问密钥, 留空表示不校验(只监听回环地址时可接受)
KLLM_LOCAL_KEY=
# 缓存目录(凭据缓存 + 用量账本), 默认 ~/.cache/kllm
# KLLM_CACHE_DIR=
KLLM_TIMEOUT=600
KLLM_DEFAULT_MODEL=google/gemini-3-flash-preview
# 上游 429/5xx/网络错误的重试次数与退避基数(秒)
KLLM_MAX_RETRIES=3
KLLM_RETRY_BASE_DELAY=1.0
KLLM_RETRY_MAX_DELAY=30
# 日志: DEBUG / INFO / WARNING / ERROR; 可选写日志文件
KLLM_LOG_LEVEL=INFO
# KLLM_LOG_FILE=
# ---- kcloud ----
KCLOUD_DEFAULT_MODEL=anthropic/claude-sonnet-5@default
# 产物目录, 默认 ./runs
# KCLOUD_RUNS_DIR=
KCLOUD_RUN_WAIT=900
KCLOUD_PUSH_WAIT=600
# 单条 kaggle 命令的超时(秒)
KAGGLE_CLI_TIMEOUT=1800
